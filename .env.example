# 数据库(SQLite,文件形式)
DATABASE_URL="file:./dev.db"

# 应用基础配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-this-to-a-random-string

# ============ 各社媒平台 OAuth 准入凭证 ============
# 注意:多数平台需企业开发者账号审核。填入后即可启用对应平台对接。

# Twitter / X (OAuth 2.0 PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Facebook (Graph API)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram(复用 Facebook Graph API,需 Business 账号)
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube (Google OAuth 2.0)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (Content Posting API,需企业认证)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn (Marketing / Share API)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit (OAuth 2.0)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pinterest (API v5)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ============ 新增平台 ============

# VKontakte (俄罗斯主流社交)
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Telegram (Bot API 模式,无需 OAuth)
# 通过 @BotFather 获取 Bot Token;channel_id 用 @频道名 或 -100 开头的数字ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Snapchat (Marketing API,需广告账户)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_AD_ACCOUNT_ID=

# WhatsApp (Cloud API,复用 Meta 凭证)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=

# LINE (Japan 主流 IM,Official Account)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# KakaoTalk (Korea 主流 IM)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=